{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts for authentication, roles and assigned worksite",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string" },
        "worksiteAssigned": { "type": "string" },
        "worksiteId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "materials": {
      "title": "Materials",
      "description": "Inventory stock items across construction sites",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "minQuantity": { "type": "number" },
        "maxQuantity": { "type": "number" },
        "avgUnitPrice": { "type": "number" },
        "location": { "type": "string" },
        "supplier": { "type": "string" },
        "lastUpdate": { "type": "string" },
        "notes": { "type": "string" },
        "workSiteId": { "type": "string" },
        "workSiteName": { "type": "string" }
      },
      "required": ["id", "name", "quantity", "unit"]
    },
    "movements": {
      "title": "Movements",
      "description": "Inbound and outbound stock movements for specific worksites",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "type": { "type": "string" },
        "materialId": { "type": "string" },
        "materialName": { "type": "string" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "workSiteId": { "type": "string" },
        "workSiteName": { "type": "string" },
        "requester": { "type": "string" },
        "responsible": { "type": "string" },
        "notes": { "type": "string" },
        "workPhase": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "unitPrice": { "type": "number" }
      },
      "required": ["id", "materialId", "quantity", "type"]
    },
    "worksites": {
      "title": "Worksites",
      "description": "Construction sites / canteiros de obras",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "address": { "type": "string" },
        "engineerInCharge": { "type": "string" },
        "status": { "type": "string" },
        "budgetMaterials": { "type": "number" },
        "totalSpentMaterials": { "type": "number" },
        "startDate": { "type": "string" }
      },
      "required": ["id", "name", "code"]
    },
    "requisitions": {
      "title": "Requisitions",
      "description": "Material requisitions created by Mestres de Obra or Almoxarifes",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "date": { "type": "string" },
        "workSiteId": { "type": "string" },
        "workSiteName": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterRole": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "code", "workSiteId", "requesterName"]
    },
    "catalogoInsumos": {
      "title": "Catálogo Global de Insumos",
      "description": "Global catalog of construction inputs shared across all worksites",
      "properties": {
        "id": { "type": "string" },
        "codigoExterno": { "type": "string" },
        "nome": { "type": "string" },
        "categoria": { "type": "string" },
        "subcategoria": { "type": "string" },
        "unidade": { "type": "string" },
        "precoUnitario": { "type": "number" },
        "ativo": { "type": "boolean" },
        "observacoes": { "type": "string" },
        "paginaFonte": { "type": "string" },
        "criadoEm": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["id", "codigoExterno", "nome"]
    },
    "estoquesPorCanteiro": {
      "title": "Estoques por Canteiro",
      "description": "Worksite specific stock quantity, min stock and location",
      "properties": {
        "id": { "type": "string" },
        "canteiroId": { "type": "string" },
        "insumoId": { "type": "string" },
        "estoqueAtual": { "type": "number" },
        "estoqueMinimo": { "type": "number" },
        "localArmazenamento": { "type": "string" },
        "observacoesDoCanteiro": { "type": "string" },
        "criadoEm": { "type": "string" },
        "atualizadoEm": { "type": "string" }
      },
      "required": ["id", "canteiroId", "insumoId"]
    },
    "historicoAlteracoesInsumos": {
      "title": "Histórico de Alterações de Insumos",
      "description": "Audit trail log for catalog updates, imports and inactivations",
      "properties": {
        "id": { "type": "string" },
        "insumoId": { "type": "string" },
        "insumoCodigoExterno": { "type": "string" },
        "insumoNome": { "type": "string" },
        "usuarioId": { "type": "string" },
        "usuarioNome": { "type": "string" },
        "dataHora": { "type": "string" },
        "tipoAlteracao": { "type": "string" },
        "campoAlterado": { "type": "string" },
        "informacaoAnterior": { "type": "string" },
        "informacaoNova": { "type": "string" }
      },
      "required": ["id", "insumoId", "usuarioNome", "dataHora"]
    }
  }
}
